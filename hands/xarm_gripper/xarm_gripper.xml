<!--
UFACTORY xArm Gripper (2-finger 4-bar parallel linkage), adapted from MuJoCo Menagerie's
`ufactory_xarm7/hand.xml` (BSD-3-Clause, copyright UFACTORY Inc., see assets/LICENSE).

Kinematics and visual meshes match the real xArm Gripper (85 mm stroke, parallelogram
4-bar linkages keep left_finger and right_finger strictly parallel). The palm sits at
z = 0.200 m pointing downward (-z) on a vertical lift servo so the pads straddle the
default 100 mm cylinder at mid-height (z = 0.050 m) when closed to r = 25 mm.

Each driver joint uses a pure force motor with gear = 0.0507 m/rad (the horizontal
moment arm |dy/dq| at grasp radius 25 mm), so `close: {force_n: 6}` produces ~6 N normal
force per pad at rest. Joint frictionloss and spring bias are removed so commanded
forces reach the pads directly without deadband.

Pads are attached by slipsim on `left_finger` and `right_finger`:
  - {body: left_finger,  pos_mm: [0, -32, 41], euler_deg: [0, 0, -90]}
  - {body: right_finger, pos_mm: [0,  32, 41], euler_deg: [0, 0,  90]}
-->
<mujoco model="xarm_gripper">
  <compiler angle="radian" autolimits="true" meshdir="assets"/>

  <asset>
    <material name="white" rgba="0.92 0.92 0.92 1"/>
    <material name="black" rgba="0.15 0.15 0.18 1"/>

    <mesh file="base_link.stl"/>
    <mesh file="left_outer_knuckle.stl"/>
    <mesh file="left_finger.stl"/>
    <mesh file="left_inner_knuckle.stl"/>
    <mesh file="right_outer_knuckle.stl"/>
    <mesh file="right_finger.stl"/>
    <mesh file="right_inner_knuckle.stl"/>
  </asset>

  <default>
    <default class="xarm_gripper">
      <geom type="mesh" material="black" contype="0" conaffinity="0"/>
      <joint axis="1 0 0" range="-0.05 0.85"/>
      <default class="driver">
        <joint range="0 0.85" armature="0.005" damping="0.06" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint range="-0.1 0.9" armature="0.002" damping="0.005"/>
      </default>
      <default class="inner_knuckle">
        <joint range="-0.1 0.9" armature="0.002" damping="0.005"/>
      </default>
    </default>
  </default>

  <worldbody>
    <body name="palm" pos="0 0 0.200" gravcomp="1">
      <inertial pos="0 0 0" mass="0.3" diaginertia="1e-3 1e-3 1e-3"/>
      <joint name="lift" type="slide" axis="0 0 1"/>

      <body name="xarm_gripper_base_link" pos="0 0 0" quat="0 0 1 0" gravcomp="1" childclass="xarm_gripper">
        <inertial pos="-0.00065489 -0.0018497 0.048028" quat="0.997403 -0.0717512 -0.0061836 0.000477479"
                  mass="0.54156" diaginertia="0.000471093 0.000332307 0.000254799"/>
        <geom mesh="base_link" material="white"/>

        <body name="left_outer_knuckle" pos="0 0.035 0.059098" gravcomp="1">
          <inertial pos="0 0.021559 0.015181" quat="0.47789 0.87842 0 0"
                    mass="0.033618" diaginertia="1.9111e-05 1.79089e-05 1.90167e-06"/>
          <joint name="left_driver_joint" class="driver"/>
          <geom mesh="left_outer_knuckle"/>
          <body name="left_finger" pos="0 0.035465 0.042039" gravcomp="1">
            <inertial pos="0 -0.016413 0.029258" quat="0.697634 0.115353 -0.115353 0.697634"
                      mass="0.048304" diaginertia="1.88037e-05 1.7493e-05 3.56792e-06"/>
            <joint name="left_finger_joint" axis="-1 0 0" class="follower"/>
            <geom mesh="left_finger"/>
            <geom type="box" size="0.008 0.002 0.008" pos="0 -0.030 0.041" rgba="0.15 0.15 0.18 1"/>
          </body>
        </body>

        <body name="left_inner_knuckle" pos="0 0.02 0.074098" gravcomp="1">
          <inertial pos="1.86601e-06 0.0220468 0.0261335" quat="0.664139 -0.242732 0.242713 0.664146"
                    mass="0.0230126" diaginertia="8.34216e-06 6.0949e-06 2.75601e-06"/>
          <joint name="left_inner_knuckle_joint" class="inner_knuckle"/>
          <geom mesh="left_inner_knuckle"/>
        </body>

        <body name="right_outer_knuckle" pos="0 -0.035 0.059098" gravcomp="1">
          <inertial pos="0 -0.021559 0.015181" quat="0.87842 0.47789 0 0"
                    mass="0.033618" diaginertia="1.9111e-05 1.79089e-05 1.90167e-06"/>
          <joint name="right_driver_joint" axis="-1 0 0" class="driver"/>
          <geom mesh="right_outer_knuckle"/>
          <body name="right_finger" pos="0 -0.035465 0.042039" gravcomp="1">
            <inertial pos="0 0.016413 0.029258" quat="0.697634 -0.115356 0.115356 0.697634"
                      mass="0.048304" diaginertia="1.88038e-05 1.7493e-05 3.56779e-06"/>
            <joint name="right_finger_joint" class="follower"/>
            <geom mesh="right_finger"/>
            <geom type="box" size="0.008 0.002 0.008" pos="0 0.030 0.041" rgba="0.15 0.15 0.18 1"/>
          </body>
        </body>

        <body name="right_inner_knuckle" pos="0 -0.02 0.074098" gravcomp="1">
          <inertial pos="1.866e-06 -0.022047 0.026133" quat="0.66415 0.242702 -0.242721 0.664144"
                    mass="0.023013" diaginertia="8.34209e-06 6.0949e-06 2.75601e-06"/>
          <joint name="right_inner_knuckle_joint" axis="-1 0 0" class="inner_knuckle"/>
          <geom mesh="right_inner_knuckle"/>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="right_inner_knuckle" body2="right_outer_knuckle"/>
    <exclude body1="right_inner_knuckle" body2="right_finger"/>
    <exclude body1="left_inner_knuckle" body2="left_outer_knuckle"/>
    <exclude body1="left_inner_knuckle" body2="left_finger"/>
    <exclude body1="left_inner_knuckle" body2="xarm_gripper_base_link"/>
    <exclude body1="right_inner_knuckle" body2="xarm_gripper_base_link"/>
    <exclude body1="left_outer_knuckle" body2="xarm_gripper_base_link"/>
    <exclude body1="right_outer_knuckle" body2="xarm_gripper_base_link"/>
  </contact>

  <equality>
    <connect anchor="0 0.015 0.015" body1="right_finger" body2="right_inner_knuckle" solref="0.005 1"/>
    <connect anchor="0 -0.015 0.015" body1="left_finger" body2="left_inner_knuckle" solref="0.005 1"/>
  </equality>

  <actuator>
    <position name="lift" joint="lift" kp="20000" kv="500"/>
    <motor name="left" joint="left_driver_joint" gear="0.0507"/>
    <motor name="right" joint="right_driver_joint" gear="0.0507"/>
  </actuator>
</mujoco>
